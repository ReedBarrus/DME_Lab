  "prospective_candidate_primitive": {
    "name": "SATISFIES_DECLARED_POLICY",
    "signature": "SATISFIES_DECLARED_POLICY(candidate_path, declared_selection_relation) -> true | false",
    "requirements": {
      "declared_before_realization": true,
      "mechanically_inspectable": true,
      "post_hoc_interpretation_admissible": false
    }
  },
  "candidate_admissibility_requirements": {
    "C1_EXPLICIT_RELATION": {
      "requirement": "The candidate selection relation is explicitly represented and mechanically identifiable.",
      "scar": "DECLARED_POLICY != IMPLICIT_IMPLEMENTATION_BEHAVIOR"
    },
    "C2_INDEPENDENT_SATISFACTION_TEST": {
      "requirement": "For any selected candidate path, the experiment can independently determine whether that path satisfies the declared relation.",
      "scar": "ROUTE_CHANGED != ROUTE_SATISFIES_POLICY"
    },
    "C3_REPRESENTATION_INVARIANCE": {
      "geometry": [
        "VALID_POLICY_P1 + REPRESENTATION_R1 -> ROUTE_X",
        "VALID_POLICY_P1 + REPRESENTATION_R2 -> ROUTE_X",
        "R1 != R2 only in coordinates declared irrelevant by P1",
        "SATISFIES_DECLARED_POLICY(X, P1) == true"
      ]
    },
    "C4_POLICY_SENSITIVITY": {
      "geometry": [
        "VALID_POLICY_P1 + REPRESENTATION_R1 -> ROUTE_X -> SATISFIES(P1, X)",
        "VALID_POLICY_P2 + REPRESENTATION_R1 -> ROUTE_Y -> SATISFIES(P2, Y)",
        "P1 != P2",
        "X != Y"
      ],
      "requirement": "Policy intervention must alter selection through the declared relation, not merely correlate with a route change.",
      "scar": "POLICY_CHANGED_THEN_ROUTE_CHANGED != ROUTE_CHANGED_IN_ACCORDANCE_WITH_POLICY"
    },
    "C5_POLICY_ABSENT": {
      "condition": "MULTIPLE_EQUAL_HOP_CANDIDATES + NO_DECLARED_POLICY",
      "required_consequence": "NO_SILENT_SELECTION"
    },
    "C6_POLICY_INVALID": {
      "condition": "MULTIPLE_EQUAL_HOP_CANDIDATES + DECLARED_POLICY_INVALID",
      "required_consequence": [
        "NO_SILENT_SELECTION",
        "INVALIDITY_LEGIBLE"
      ],
      "scar": "POLICY_ABSENT != POLICY_INVALID"
    },
    "C7_LEGACY_NON_DOMINANCE": {
      "condition": "VALID_DECLARED_POLICY_P",
      "hostile_permutations": [
        "edge_id_labels",
        "edge_declaration_order",
        "any_other_coordinates_explicitly_outside_P"
      ],
      "required_consequence": "NO_SELECTION_OUTSIDE_P",
      "scar": "LEGACY_REPRESENTATION_DEPENDENT_SELECTION_MUST_NOT_OVERRIDE_VALID_DECLARED_POLICY"
    }
  },
  "anti_smuggling_distinctions": [
    "POLICY_FIELD_PRESENT != POLICY_FIELD_EFFECTIVE",
    "POLICY_DETERMINES_SELECTION != POLICY_DIRECTLY_NAMES_PATH",
