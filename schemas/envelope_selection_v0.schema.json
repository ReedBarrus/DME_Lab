{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dme-lab.invalid/schemas/envelope_selection_v0.schema.json",
  "title": "Envelope Selection v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "selection_id",
    "campaign_id",
    "campaign_sha256",
    "request_id",
    "request_sha256",
    "selected_by",
    "selected_at_basis_refs",
    "selected_at_basis_sha256",
    "selection_kind",
    "selection_reason",
    "authorization_effect",
    "execution_effect",
    "standing_effect"
  ],
  "properties": {
    "schema": {"const": "envelope_selection_v0"},
    "selection_id": {"type": "string", "minLength": 1},
    "campaign_id": {"type": "string", "minLength": 1},
    "campaign_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "request_id": {"type": "string", "minLength": 1},
    "request_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "selected_by": {"type": "string", "minLength": 1},
    "selected_at_basis_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "selected_at_basis_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "selection_kind": {
      "enum": ["SELECTED_FOR_PACKET_FORMATION", "SELECTION_RELEASED"]
    },
    "selection_reason": {"type": ["string", "null"]},
    "authorization_effect": {"const": "NONE"},
    "execution_effect": {"const": "NONE"},
    "standing_effect": {"const": "NONE"}
  }
}
