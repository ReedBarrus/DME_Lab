{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dme-lab.invalid/schemas/implementation_request_v0.schema.json",
  "title": "Implementation Request v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "request_id",
    "seat_id",
    "repository",
    "basis_commit",
    "allowed_paths",
    "requested_effect",
    "qualification_contract",
    "operator_id",
    "authority_ref"
  ],
  "properties": {
    "schema": {"const": "implementation_request_v0"},
    "request_id": {"type": "string", "minLength": 1},
    "seat_id": {"const": "LABBOIB"},
    "repository": {"type": "string", "minLength": 1},
    "basis_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "allowed_paths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "requested_effect": {"type": "string", "minLength": 1},
    "qualification_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exact_file_sha256", "declared_check_ids"],
      "properties": {
        "exact_file_sha256": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "declared_check_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "operator_id": {"const": "ISOLATED_IMPLEMENTATION_FIXTURE"},
    "authority_ref": {"type": "string", "minLength": 1}
  }
}
