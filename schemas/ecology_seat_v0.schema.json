{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dme-lab.invalid/schemas/ecology_seat_v0.schema.json",
  "title": "Ecology Seat v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "seat_id",
    "role_id",
    "seat_state",
    "occupant_id",
    "invocation_id",
    "work_claim_ref",
    "cursor_ref",
    "authority_effect",
    "execution_effect"
  ],
  "properties": {
    "schema": {
      "const": "ecology_seat_v0"
    },
    "seat_id": {
      "type": "string",
      "minLength": 1
    },
    "role_id": {
      "type": "string",
      "minLength": 1
    },
    "seat_state": {
      "enum": [
        "AVAILABLE_UNOCCUPIED",
        "OCCUPIED_CANDIDATE"
      ]
    },
    "occupant_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "invocation_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "work_claim_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "cursor_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "authority_effect": {
      "const": "NONE"
    },
    "execution_effect": {
      "const": "NONE"
    }
  }
}
