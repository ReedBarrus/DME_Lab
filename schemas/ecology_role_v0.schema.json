{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dme-lab.invalid/schemas/ecology_role_v0.schema.json",
  "title": "Ecology Role v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "role_id",
    "purpose",
    "may_observe",
    "may_produce",
    "may_request",
    "forbidden_effect_classes",
    "authority_effect",
    "execution_effect"
  ],
  "properties": {
    "schema": {
      "const": "ecology_role_v0"
    },
    "role_id": {
      "type": "string",
      "minLength": 1
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "may_observe": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "may_produce": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "may_request": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "forbidden_effect_classes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "authority_effect": {
      "const": "NONE"
    },
    "execution_effect": {
      "const": "NONE"
    }
  }
}
