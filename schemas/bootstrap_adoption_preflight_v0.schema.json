{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dme-lab.invalid/schemas/bootstrap_adoption_preflight_v0.schema.json",
  "title": "Bootstrap Adoption Preflight v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "event_id",
    "protocol_object_id",
    "protocol_path",
    "protocol_git_blob_sha",
    "bootstrap_object_git_blob_sha",
    "review_git_blob_sha",
    "authorization_git_blob_sha",
    "preflight_implementation_git_blob_sha",
    "review_disposition",
    "authorization_decision",
    "target",
    "observed_precondition",
    "identity_checks",
    "repository_witness",
    "result",
    "execution_admitted"
  ],
  "properties": {
    "schema": {"const": "bootstrap_adoption_preflight_v0"},
    "event_id": {"const": "BOOTSTRAP_ADOPTION_001"},
    "protocol_object_id": {"const": "PROMOTION_PROTOCOL_v0"},
    "protocol_path": {"const": "docs/operations/PROMOTION_PROTOCOL_v0.md"},
    "protocol_git_blob_sha": {"const": "49fbe7c792511b6c7104a07aecba3ced84108ff8"},
    "bootstrap_object_git_blob_sha": {"const": "ae45b7ef6433b2345c0a6240802a6ba6df0106e9"},
    "review_git_blob_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "authorization_git_blob_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "preflight_implementation_git_blob_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "review_disposition": {"enum": ["ADMIT", "HOLD", "REJECT", "REQUIRE_REPRESSURE"]},
    "authorization_decision": {"enum": ["AUTHORIZE", "DENY"]},
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "target_ref",
        "pull_request",
        "authorized_target_head",
        "observed_target_head",
        "authorized_pr_head",
        "observed_pr_head"
      ],
      "properties": {
        "repository": {"const": "ReedBarrus/DME_Lab"},
        "target_ref": {"const": "main"},
        "pull_request": {"const": 30},
        "authorized_target_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "observed_target_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "authorized_pr_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "observed_pr_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      }
    },
    "observed_precondition": {"enum": ["TRUE", "FALSE", "UNRESOLVED"]},
    "identity_checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "preflight_implementation_matches_bootstrap_object",
        "protocol_matches_bootstrap_object",
        "review_matches_protocol",
        "review_matches_bootstrap_object",
        "review_independence_valid",
        "authorization_matches_protocol",
        "authorization_matches_bootstrap_object",
        "authorization_matches_review",
        "authorization_effect_matches",
        "target_matches_authorization",
        "target_head_matches_authorization",
        "pr_head_matches_authorization"
      ],
      "properties": {
        "preflight_implementation_matches_bootstrap_object": {"enum": ["PASS", "FAIL"]},
        "protocol_matches_bootstrap_object": {"enum": ["PASS", "FAIL"]},
        "review_matches_protocol": {"enum": ["PASS", "FAIL"]},
        "review_matches_bootstrap_object": {"enum": ["PASS", "FAIL"]},
        "review_independence_valid": {"enum": ["PASS", "FAIL"]},
        "authorization_matches_protocol": {"enum": ["PASS", "FAIL"]},
        "authorization_matches_bootstrap_object": {"enum": ["PASS", "FAIL"]},
        "authorization_matches_review": {"enum": ["PASS", "FAIL"]},
        "authorization_effect_matches": {"enum": ["PASS", "FAIL"]},
        "target_matches_authorization": {"enum": ["PASS", "FAIL"]},
        "target_head_matches_authorization": {"enum": ["PASS", "FAIL"]},
        "pr_head_matches_authorization": {"enum": ["PASS", "FAIL"]}
      }
    },
    "repository_witness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observed_main_head",
        "protocol_path_present_on_main",
        "witness_method"
      ],
      "properties": {
        "observed_main_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "protocol_path_present_on_main": {"type": "boolean"},
        "witness_method": {"type": "string", "minLength": 1}
      }
    },
    "result": {"enum": ["PASS", "FAIL"]},
    "execution_admitted": {"type": "boolean"}
  },
  "allOf": [
    {
      "if": {"properties": {"result": {"const": "PASS"}}},
      "then": {
        "properties": {
          "review_disposition": {"const": "ADMIT"},
          "authorization_decision": {"const": "AUTHORIZE"},
          "observed_precondition": {"const": "TRUE"},
          "identity_checks": {
            "properties": {
              "preflight_implementation_matches_bootstrap_object": {"const": "PASS"},
              "protocol_matches_bootstrap_object": {"const": "PASS"},
              "review_matches_protocol": {"const": "PASS"},
              "review_matches_bootstrap_object": {"const": "PASS"},
              "review_independence_valid": {"const": "PASS"},
              "authorization_matches_protocol": {"const": "PASS"},
              "authorization_matches_bootstrap_object": {"const": "PASS"},
              "authorization_matches_review": {"const": "PASS"},
              "authorization_effect_matches": {"const": "PASS"},
              "target_matches_authorization": {"const": "PASS"},
              "target_head_matches_authorization": {"const": "PASS"},
              "pr_head_matches_authorization": {"const": "PASS"}
            }
          },
          "repository_witness": {
            "properties": {
              "protocol_path_present_on_main": {"const": false}
            }
          },
          "execution_admitted": {"const": true}
        }
      }
    },
    {
      "if": {"properties": {"result": {"const": "FAIL"}}},
      "then": {
        "properties": {
          "execution_admitted": {"const": false}
        }
      }
    }
  ]
}
