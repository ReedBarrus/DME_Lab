{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://dme-lab.invalid/schemas/temporal_seat_injection_v0.schema.json",
  "title":"Temporal Seat Injection v0",
  "type":"object",
  "additionalProperties":false,
  "required":[
    "schema_version","injection_id","target_seat","kind","body","refs",
    "authority","created_by"
  ],
  "properties":{
    "schema_version":{"const":"temporal_seat_injection_v0"},
    "injection_id":{"type":"string","pattern":"^LI-[0-9]{6}$"},
    "target_seat":{"const":"LABBOIB"},
    "kind":{"enum":["MESSAGE","PRIORITY","PACKET_REF","ACTION_REQUEST","AUTHORITY_OBJECT_REF"]},
    "body":{"type":"string","minLength":1},
    "refs":{"type":"array","items":{"type":"string","minLength":1}},
    "authority":{
      "type":"object",
      "additionalProperties":false,
      "required":["claimed","authority_ref"],
      "properties":{
        "claimed":{"type":"boolean"},
        "authority_ref":{"type":["string","null"]}
      }
    },
    "created_by":{"type":"string","minLength":1}
  }
}
