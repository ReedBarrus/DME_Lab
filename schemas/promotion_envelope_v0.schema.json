{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dme-lab.invalid/schemas/promotion_envelope_v0.schema.json",
  "title": "Promotion Envelope v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "promotion_id",
    "candidate_sha256",
    "review_sha256",
    "adjudication_sha256",
    "adjudication_decision",
    "source_carrier",
    "target_carrier",
    "exact_delta",
    "expected_post_status",
    "non_consequences",
    "authorization_status",
    "authority_effect"
  ],
  "properties": {
    "schema": {"const": "promotion_envelope_v0"},
    "promotion_id": {"type": "string", "minLength": 1},
    "candidate_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "review_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "adjudication_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "adjudication_decision": {"const": "ADMIT"},
    "source_carrier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "observed_head"],
      "properties": {
        "ref": {"type": "string", "minLength": 1},
        "observed_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      }
    },
    "target_carrier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "observed_head"],
      "properties": {
        "ref": {"type": "string", "minLength": 1},
        "observed_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      }
    },
    "exact_delta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "description", "paths"],
      "properties": {
        "kind": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "paths": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "expected_post_status": {"type": "string", "minLength": 1},
    "non_consequences": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "authorization_status": {"const": "REQUIRES_EXPLICIT_HUMAN_AUTHORITY"},
    "authority_effect": {"const": "NONE"}
  }
}
