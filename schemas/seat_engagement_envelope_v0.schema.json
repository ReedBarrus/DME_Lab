{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"seat_engagement_envelope_v0.schema.json",
  "title":"Seat Engagement Envelope v0",
  "type":"object",
  "additionalProperties":false,
  "required":["schema","envelope_id","campaign_id","pressure_id","projected_by","projected_at_basis","target_lane_id","target_seat_id","target_role","task_id","bounded_unit_id","target_lineage","objective","completion_criterion","stop_conditions","observation_scope","mutation_scope","execution_scope","required_basis_refs","required_capabilities","expected_peer_surfaces","expected_artifact_scope","consequence_envelope_id","authority_grant_refs","authority_lifetime","recovery_required","checkpoint_required","next_unit_authorized","authority_effect","execution_effect"],
  "properties":{
    "schema":{"const":"seat_engagement_envelope_v0"},
    "envelope_id":{"type":"string","minLength":1},
    "campaign_id":{"type":["string","null"]},
    "pressure_id":{"type":"string","minLength":1},
    "projected_by":{"type":"string","minLength":1},
    "projected_at_basis":{"type":"string","pattern":"^[0-9a-f]{40}$"},
    "target_lane_id":{"type":"string","minLength":1},
    "target_seat_id":{"type":"string","minLength":1},
    "target_role":{"type":"string","minLength":1},
    "task_id":{"type":"string","minLength":1},
    "bounded_unit_id":{"type":"string","minLength":1},
    "target_lineage":{"type":"string","minLength":1},
    "objective":{"type":"string","minLength":1},
    "completion_criterion":{"type":"string","minLength":1},
    "stop_conditions":{"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true},
    "observation_scope":{"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true},
    "mutation_scope":{"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true},
    "execution_scope":{"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true},
    "required_basis_refs":{"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true},
    "required_capabilities":{"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true},
    "expected_peer_surfaces":{"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true},
    "expected_artifact_scope":{"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true},
    "consequence_envelope_id":{"type":"string","minLength":1},
    "authority_grant_refs":{"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true},
    "authority_lifetime":{"const":"ONE_UNIT"},
    "recovery_required":{"type":"boolean"},
    "checkpoint_required":{"const":true},
    "next_unit_authorized":{"const":false},
    "authority_effect":{"const":"NONE"},
    "execution_effect":{"const":"NONE"}
  }
}
