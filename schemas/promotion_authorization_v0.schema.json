{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dme-lab.invalid/schemas/promotion_authorization_v0.schema.json",
  "title": "Promotion Authorization v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "authorization_id",
    "promotion_id",
    "envelope_sha256",
    "decision",
    "authority_ref",
    "authorized_effect",
    "scope",
    "explicit_non_authorizations"
  ],
  "properties": {
    "schema": {"const": "promotion_authorization_v0"},
    "authorization_id": {"type": "string", "minLength": 1},
    "promotion_id": {"type": "string", "minLength": 1},
    "envelope_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "decision": {"enum": ["AUTHORIZE", "DENY"]},
    "authority_ref": {"type": "string", "minLength": 1},
    "authorized_effect": {"type": "string", "minLength": 1},
    "scope": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "explicit_non_authorizations": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
