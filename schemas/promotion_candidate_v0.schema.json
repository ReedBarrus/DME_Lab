{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dme-lab.invalid/schemas/promotion_candidate_v0.schema.json",
  "title": "Promotion Candidate v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "promotion_id",
    "mode",
    "status",
    "subject",
    "source",
    "target",
    "bounded_behavior",
    "supporting_basis",
    "claim_ceiling",
    "dependency_consequence",
    "proposed_delta",
    "lineage_references",
    "known_scars",
    "non_promotions",
    "review_burden",
    "authority_effect"
  ],
  "properties": {
    "schema": {"const": "promotion_candidate_v0"},
    "promotion_id": {"type": "string", "minLength": 1},
    "mode": {
      "enum": ["NORMAL", "RETROACTIVE_FORMALIZATION"]
    },
    "status": {"const": "READY_FOR_REVIEW"},
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "identity", "description"],
      "properties": {
        "kind": {"type": "string", "minLength": 1},
        "identity": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layer", "status", "carrier_refs"],
      "properties": {
        "layer": {
          "enum": ["DISCOVERY_HISTORY", "INTEGRATION_SURFACE", "DURABLE_SUBSTRATE", "PRE_PROTOCOL"]
        },
        "status": {"type": "string", "minLength": 1},
        "carrier_refs": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layer", "status"],
      "properties": {
        "layer": {
          "enum": ["INTEGRATION_SURFACE", "DURABLE_SUBSTRATE"]
        },
        "status": {"type": "string", "minLength": 1}
      }
    },
    "bounded_behavior": {"type": "string", "minLength": 1},
    "supporting_basis": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "claim_ceiling": {"type": "string", "minLength": 1},
    "dependency_consequence": {"type": "string", "minLength": 1},
    "proposed_delta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "description", "paths"],
      "properties": {
        "kind": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "paths": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "lineage_references": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "known_scars": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "non_promotions": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "review_burden": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "authority_effect": {"const": "NONE"}
  }
}
