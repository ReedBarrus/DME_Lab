{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dme-lab.invalid/schemas/execution_envelope_request_v0.schema.json",
  "title": "Execution Envelope Request v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "request_id",
    "campaign_id",
    "campaign_sha256",
    "seat_id",
    "object_under_pressure",
    "unresolved_relation_id",
    "unresolved_relation",
    "smallest_proposed_intervention",
    "expected_observable",
    "allowed_effect_surface",
    "forbidden_effects",
    "required_authority",
    "resource_cost",
    "expected_information_gain",
    "stop_conditions",
    "packet_status",
    "authorization_effect",
    "execution_effect"
  ],
  "properties": {
    "schema": {"const": "execution_envelope_request_v0"},
    "request_id": {"type": "string", "minLength": 1},
    "campaign_id": {"type": "string", "minLength": 1},
    "campaign_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "seat_id": {"type": "string", "minLength": 1},
    "object_under_pressure": {"type": "string", "minLength": 1},
    "unresolved_relation_id": {"type": "string", "minLength": 1},
    "unresolved_relation": {"type": "string", "minLength": 1},
    "smallest_proposed_intervention": {"type": "string", "minLength": 1},
    "expected_observable": {"type": "string", "minLength": 1},
    "allowed_effect_surface": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "forbidden_effects": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "required_authority": {"type": "string", "minLength": 1},
    "resource_cost": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resource_class", "model_calls", "notes"],
      "properties": {
        "resource_class": {"enum": ["DETERMINISTIC", "LOCAL_CHEAP", "EXTERNAL_STRONG"]},
        "model_calls": {"type": "integer", "minimum": 0},
        "notes": {"type": "string"}
      }
    },
    "expected_information_gain": {"type": "string", "minLength": 1},
    "stop_conditions": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "packet_status": {"const": "CANDIDATE_REQUEST"},
    "authorization_effect": {"const": "NONE"},
    "execution_effect": {"const": "NONE"}
  }
}
