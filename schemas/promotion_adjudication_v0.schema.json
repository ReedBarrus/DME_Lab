{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dme-lab.invalid/schemas/promotion_adjudication_v0.schema.json",
  "title": "Promotion Adjudication v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "promotion_id",
    "candidate_sha256",
    "review_sha256",
    "review_disposition",
    "adjudicator",
    "target_layer",
    "decision",
    "basis",
    "authority_effect"
  ],
  "properties": {
    "schema": {"const": "promotion_adjudication_v0"},
    "promotion_id": {"type": "string", "minLength": 1},
    "candidate_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "review_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "review_disposition": {
      "enum": ["ADMIT", "HOLD", "REJECT", "REQUIRE_REPRESSURE"]
    },
    "adjudicator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seat", "identity"],
      "properties": {
        "seat": {"type": "string", "minLength": 1},
        "identity": {"type": "string", "minLength": 1}
      }
    },
    "target_layer": {
      "enum": ["INTEGRATION_SURFACE", "DURABLE_SUBSTRATE"]
    },
    "decision": {
      "enum": ["ADMIT", "HOLD", "REJECT", "REQUIRE_REPRESSURE"]
    },
    "basis": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "authority_effect": {"const": "NONE"}
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "decision": {"const": "ADMIT"}
        }
      },
      "then": {
        "properties": {
          "review_disposition": {"const": "ADMIT"}
        }
      }
    }
  ]
}
