{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "preparation_assignment_v0.schema.json",
  "title": "PREPARATION_ASSIGNMENT_v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "assignment_id",
    "campaign_id",
    "campaign_sha256",
    "request_id",
    "request_sha256",
    "selection_ref",
    "selection_sha256",
    "seat_id",
    "preparation_kind",
    "assigned_by",
    "assigned_at_basis_refs",
    "assigned_at_basis_sha256",
    "assignment_kind",
    "assignment_reason",
    "authority_effect",
    "execution_effect",
    "standing_effect",
    "priority_effect",
    "wake_effect"
  ],
  "properties": {
    "schema": {"const": "preparation_assignment_v0"},
    "assignment_id": {"type": "string", "minLength": 1},
    "campaign_id": {"type": "string", "minLength": 1},
    "campaign_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "request_id": {"type": "string", "minLength": 1},
    "request_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "selection_ref": {"type": "string", "minLength": 1},
    "selection_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "seat_id": {"type": "string", "minLength": 1},
    "preparation_kind": {
      "enum": [
        "RESOLVE_REFS",
        "REVALIDATE_BASIS",
        "ASSEMBLE_EVIDENCE",
        "DRAFT_PACKET",
        "REQUEST_REVIEW",
        "REVIEW_RESULT",
        "ESTIMATE_RESOURCES",
        "DETECT_CONFLICTS",
        "DERIVE_STOP_CONDITIONS"
      ]
    },
    "assigned_by": {"const": "REED"},
    "assigned_at_basis_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "assigned_at_basis_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "assignment_kind": {"enum": ["ASSIGNED", "ASSIGNMENT_RELEASED"]},
    "assignment_reason": {"type": ["string", "null"]},
    "authority_effect": {"const": "NONE"},
    "execution_effect": {"const": "NONE"},
    "standing_effect": {"const": "NONE"},
    "priority_effect": {"const": "NONE"},
    "wake_effect": {"const": "NONE"}
  }
}
