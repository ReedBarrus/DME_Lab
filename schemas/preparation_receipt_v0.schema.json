{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dme-lab.invalid/schemas/preparation_receipt_v0.schema.json",
  "title": "Preparation Receipt v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "preparation_id",
    "campaign_id",
    "campaign_sha256",
    "request_id",
    "request_sha256",
    "selection_ref",
    "selection_sha256",
    "prepared_by",
    "preparation_kind",
    "preparation_basis_refs",
    "preparation_basis_sha256",
    "input_refs",
    "output_refs",
    "mechanical_status",
    "review_disposition",
    "preparation_effect",
    "canonical_mutation_effect",
    "authorization_effect",
    "execution_effect",
    "standing_effect",
    "priority_effect"
  ],
  "properties": {
    "schema": {"const": "preparation_receipt_v0"},
    "preparation_id": {"type": "string", "minLength": 1},
    "campaign_id": {"type": "string", "minLength": 1},
    "campaign_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "request_id": {"type": "string", "minLength": 1},
    "request_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "selection_ref": {"type": "string", "minLength": 1},
    "selection_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "prepared_by": {"type": "string", "minLength": 1},
    "preparation_kind": {
      "enum": [
        "RESOLVE_REFS",
        "REVALIDATE_BASIS",
        "ASSEMBLE_EVIDENCE",
        "DRAFT_PACKET",
        "REQUEST_REVIEW",
        "REVIEW_RESULT",
        "ESTIMATE_RESOURCES",
        "DETECT_CONFLICTS",
        "DERIVE_STOP_CONDITIONS"
      ]
    },
    "preparation_basis_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "preparation_basis_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "input_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "output_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "mechanical_status": {"enum": ["PASS", "FAIL", "PARTIAL"]},
    "review_disposition": {"type": ["string", "null"], "enum": ["PASS", "OBJECTION", null]},
    "preparation_effect": {"const": "PREPARATION_ONLY"},
    "canonical_mutation_effect": {"const": "NONE"},
    "authorization_effect": {"const": "NONE"},
    "execution_effect": {"const": "NONE"},
    "standing_effect": {"const": "NONE"},
    "priority_effect": {"const": "NONE"}
  }
}
