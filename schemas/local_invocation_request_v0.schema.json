{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "LOCAL_INVOCATION_REQUEST_V0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "enabled",
    "source_ref",
    "input_path",
    "input_sha256",
    "model",
    "temperature",
    "max_tokens",
    "purpose"
  ],
  "properties": {
    "schema_version": {
      "const": "LOCAL_INVOCATION_REQUEST_V0"
    },
    "request_id": {
      "type": "string",
      "pattern": "^[A-Z0-9][A-Z0-9_.-]{2,95}$"
    },
    "enabled": {
      "type": "boolean"
    },
    "source_ref": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "input_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "input_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "model": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "temperature": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    },
    "max_tokens": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8192
    },
    "purpose": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    }
  }
}
