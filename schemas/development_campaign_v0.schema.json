{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dme-lab.invalid/schemas/development_campaign_v0.schema.json",
  "title": "Development Campaign v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "campaign_id",
    "title",
    "basis_refs",
    "objective",
    "claim_ceiling",
    "target_objects",
    "unresolved_relations",
    "pressure_points",
    "dependency_edges",
    "proposal_allowance",
    "completion_criteria",
    "stop_conditions",
    "explicit_non_authorizations",
    "status",
    "authority_effect",
    "execution_effect",
    "adoption_effect"
  ],
  "properties": {
    "schema": {"const": "development_campaign_v0"},
    "campaign_id": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "basis_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "objective": {"type": "string", "minLength": 1},
    "claim_ceiling": {"type": "string", "minLength": 1},
    "target_objects": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "unresolved_relations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["relation_id", "statement"],
        "properties": {
          "relation_id": {"type": "string", "minLength": 1},
          "statement": {"type": "string", "minLength": 1}
        }
      }
    },
    "pressure_points": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "dependency_edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "to"],
        "properties": {
          "from": {"type": "string", "minLength": 1},
          "to": {"type": "string", "minLength": 1}
        }
      }
    },
    "proposal_allowance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_candidates",
        "max_model_calls",
        "allowed_resource_classes",
        "external_effects",
        "authority_effect"
      ],
      "properties": {
        "max_candidates": {"type": "integer", "minimum": 1, "maximum": 10},
        "max_model_calls": {"type": "integer", "minimum": 0, "maximum": 3},
        "allowed_resource_classes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["DETERMINISTIC", "LOCAL_CHEAP", "EXTERNAL_STRONG"]}
        },
        "external_effects": {"const": "NONE"},
        "authority_effect": {"const": "NONE"}
      }
    },
    "completion_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "stop_conditions": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "explicit_non_authorizations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "status": {"const": "CANDIDATE"},
    "authority_effect": {"const": "NONE"},
    "execution_effect": {"const": "NONE"},
    "adoption_effect": {"const": "NONE"}
  }
}
