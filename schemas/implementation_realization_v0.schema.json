{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dme-lab.invalid/schemas/implementation_realization_v0.schema.json",
  "title": "Implementation Realization v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "realization_id",
    "request_id",
    "realization_basis",
    "worktree_identity",
    "diff_sha256",
    "diff_bytes",
    "touched_paths",
    "added_paths",
    "modified_paths",
    "deleted_paths",
    "process_exit",
    "operator_claimed_status",
    "mechanical_checks",
    "scope_status",
    "effect_contract_status",
    "mechanical_result",
    "canonical_workspace_mutation_effect",
    "commit_effect",
    "merge_effect",
    "scientific_standing_effect"
  ],
  "properties": {
    "schema": {"const": "implementation_realization_v0"},
    "realization_id": {"type": "string", "minLength": 1},
    "request_id": {"type": "string", "minLength": 1},
    "realization_basis": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "worktree_identity": {"type": "string", "minLength": 1},
    "diff_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "diff_bytes": {"type": "integer", "minimum": 0},
    "touched_paths": {"type": "array", "items": {"type": "string"}},
    "added_paths": {"type": "array", "items": {"type": "string"}},
    "modified_paths": {"type": "array", "items": {"type": "string"}},
    "deleted_paths": {"type": "array", "items": {"type": "string"}},
    "process_exit": {"type": "integer"},
    "operator_claimed_status": {"type": "string"},
    "mechanical_checks": {"type": "array", "items": {"type": "object"}},
    "scope_status": {"enum": ["VALID", "INVALID"]},
    "effect_contract_status": {"enum": ["VALID", "INVALID"]},
    "mechanical_result": {"enum": ["PASS", "FAIL"]},
    "canonical_workspace_mutation_effect": {"const": "NONE_BY_OPERATOR"},
    "commit_effect": {"const": "NONE"},
    "merge_effect": {"const": "NONE"},
    "scientific_standing_effect": {"const": "NONE"}
  }
}
