{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dme-lab.invalid/schemas/promotion_receipt_v0.schema.json",
  "title": "Promotion Receipt v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "promotion_id",
    "mode",
    "candidate_sha256",
    "review_sha256",
    "adjudication_sha256",
    "authorization_ref",
    "envelope_sha256",
    "observed_pre_state",
    "observed_post_state",
    "executed_delta",
    "resulting_carrier",
    "resulting_status",
    "non_promotions",
    "deviations",
    "terminal_disposition"
  ],
  "properties": {
    "schema": {"const": "promotion_receipt_v0"},
    "promotion_id": {"type": "string", "minLength": 1},
    "mode": {
      "enum": ["NORMAL", "RETROACTIVE_FORMALIZATION"]
    },
    "candidate_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "review_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "adjudication_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "authorization_ref": {"type": "string", "minLength": 1},
    "envelope_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "observed_pre_state": {
      "type": "object",
      "additionalProperties": true
    },
    "observed_post_state": {
      "type": "object",
      "additionalProperties": true
    },
    "executed_delta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "description", "paths"],
      "properties": {
        "kind": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "paths": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "resulting_carrier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "observed_head"],
      "properties": {
        "ref": {"type": "string", "minLength": 1},
        "observed_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      }
    },
    "resulting_status": {"type": "string", "minLength": 1},
    "non_promotions": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "deviations": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "terminal_disposition": {
      "enum": [
        "PROMOTED",
        "RATIFIED_EXISTING_DURABLE_STATE",
        "HELD_FOR_REPAIR",
        "REJECTED",
        "REPRESSURE_REQUIRED",
        "ADMINISTRATION_INVALID"
      ]
    }
  }
}
