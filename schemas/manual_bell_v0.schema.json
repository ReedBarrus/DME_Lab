{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dme-lab.invalid/schemas/manual_bell_v0.schema.json",
  "title": "Manual Bell v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "bell_id",
    "assignment_id",
    "assignment_sha256",
    "campaign_id",
    "campaign_sha256",
    "request_id",
    "request_sha256",
    "selection_ref",
    "selection_sha256",
    "seat_id",
    "preparation_kind",
    "bell_basis_refs",
    "bell_basis_sha256",
    "wake_source_kind",
    "authority_effect",
    "execution_effect",
    "standing_effect",
    "priority_effect",
    "scheduler_effect"
  ],
  "properties": {
    "schema": {"const": "manual_bell_v0"},
    "bell_id": {"type": "string", "minLength": 1},
    "assignment_id": {"type": "string", "minLength": 1},
    "assignment_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "campaign_id": {"type": "string", "minLength": 1},
    "campaign_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "request_id": {"type": "string", "minLength": 1},
    "request_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "selection_ref": {"type": "string", "minLength": 1},
    "selection_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "seat_id": {"type": "string", "minLength": 1},
    "preparation_kind": {"const": "RESOLVE_REFS"},
    "bell_basis_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "bell_basis_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "wake_source_kind": {"const": "MANUAL_BELL"},
    "authority_effect": {"const": "NONE"},
    "execution_effect": {"const": "NONE"},
    "standing_effect": {"const": "NONE"},
    "priority_effect": {"const": "NONE"},
    "scheduler_effect": {"const": "NONE"}
  }
}
